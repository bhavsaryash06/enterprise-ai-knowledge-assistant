# App settings
APP_NAME=Enterprise AI Knowledge Assistant
APP_ENV=development

# OpenAI settings
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small

# Qdrant settings
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION_NAME=enterprise_documents

# Database settings
DATABASE_URL=sqlite:///./enterprise_ai_assistant.db

# LangSmith settings - optional for tracing/debugging
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=your_langsmith_api_key_here
LANGSMITH_PROJECT=enterprise-ai-knowledge-assistant